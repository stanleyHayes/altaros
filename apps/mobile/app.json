{
  "expo": {
    "name": "ALTAR OS",
    "slug": "altar-os",
    "scheme": "altaros",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.altaros.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#102A27"
      },
      "package": "com.altaros.app"
    },
    "plugins": [
      "expo-secure-store",
      "expo-camera",
      "expo-notifications"
    ]
  }
}
