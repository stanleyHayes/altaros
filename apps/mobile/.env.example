# The Go gateway is the single origin. See the note in src/services/api.ts.
#
# localhost only resolves to the dev machine from an iOS simulator or the web
# build. On a physical device or an Android emulator, set this to the machine's
# LAN address — e.g. http://192.168.1.20:8080/api/v1 — or the app will silently
# fail to reach any backend.
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Production EAS should use the canonical TLS gateway. The app validates the
# scheme and requires the exact /api/v1 mount before it sends credentials.
# EXPO_PUBLIC_API_URL=https://api.altaros.com/api/v1
