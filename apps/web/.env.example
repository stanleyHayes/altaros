# The Go gateway is the single origin.
#
# It serves auth, members and finance directly, and forwards everything not yet
# ported to the legacy TypeScript API on :3001. This app therefore never needs
# to know which domains have moved — a work package lands, its routes start
# being served by Go, and nothing here changes.
#
# Point this at the legacy API directly (http://localhost:3001/api/v1) only to
# isolate a problem to one side of the migration.
VITE_API_URL=http://localhost:8080/api/v1
