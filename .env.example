# ALTAR OS — Go services (cmd/altar).
#
# Copy to .env and fill in. In development, missing secrets are tolerated and
# the JWT secret falls back to a known-insecure value. In staging and
# production the boot FAILS and names every missing key (WP-05) — that is
# deliberate: the predecessor shipped a payment gateway whose verifyCharge()
# returned success unconditionally, and a missing key must never degrade into
# a stub that green-lights payments.
#
# Requirements are per-service, so the auth service is not blocked by a
# Cloudinary key it never uses. Run any service with:
#   make run SERVICE=gateway PORT=8090

# development | staging | production
APP_ENV=development
PORT=8080
DATA_REGION=gh
CORS_ORIGIN=http://localhost:4173,http://localhost:4174,http://localhost:4175,http://localhost:4176,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:8081

# --- Datastores ---------------------------------------------------------
# Shared with the legacy TypeScript API throughout the migration (ADR-005),
# so both write the same collections and no data migration is needed.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=altar-os
MONGODB_CONNECT_TIMEOUT=10s

# WARNING: a natively-installed redis-server on this port WINS over the docker
# compose one. Docker binds *:6379 but a native server binding 127.0.0.1:6379
# takes precedence for that address, so the service silently talks to the
# native Redis while `docker compose exec redis redis-cli` inspects the
# container's — two different datasets that look like one. Symptoms: flushing
# has no effect, keys you just wrote are missing, sessions survive
# `docker compose down`. Check with: lsof -nP -iTCP:6379 -sTCP:LISTEN
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# 19092, not the usual 9092 — see the note in docker-compose.yml.
KAFKA_BROKERS=127.0.0.1:19092

# --- Legacy API (strangler proxy) --------------------------------------
# The gateway forwards any route the Go services do not serve to the legacy
# TypeScript API, so the frontends see one origin throughout the migration.
# A domain moves to Go the moment its routes appear in the gateway; no client
# changes. Leave empty once the legacy API retires (WP-20) — unported paths
# will then 404, which is correct.
#
# One token works against both because the Go access token carries the `id`
# and `churchId` claims the TypeScript middleware reads. That requires BOTH
# APIs to use the same JWT_SECRET below.
LEGACY_API_URL=http://localhost:3001

# --- Auth (every service) -----------------------------------------------
# Required in staging/production. Rotating it revokes every session.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_ISSUER=altar-os

# --- Payments — Paystack (finance service) ------------------------------
# https://dashboard.paystack.com/#/settings/developers
#
# ADR-002: each church is its own Paystack SUBACCOUNT and money settles
# directly from giver to church. These keys operate the platform account that
# holds the commission split — they never hold church funds.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYMENT_CALLBACK_URL=

# Paystack signs webhooks with HMAC-SHA512 keyed by the SECRET KEY above.
# Set this to the SAME value as PAYSTACK_SECRET_KEY (it is a separate variable
# only so a key rotation can be staged). Setting it to anything else silently
# rejects every real webhook, which looks exactly like Paystack being down.
PAYSTACK_WEBHOOK_SECRET=

# --- SMS — Africa's Talking (notification service) ----------------------
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=

# --- Email — Resend (notification service) ------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Native push — FCM Android + APNs iOS (notification service) --------
# Paste the complete Firebase service-account JSON as one environment value.
# Android native tokens are sent through FCM v1.
FIREBASE_SERVICE_ACCOUNT=

# Apple token-based provider credentials. APNS_PRIVATE_KEY is the complete
# .p8 PEM value. Use sandbox only for development-signed iOS builds; TestFlight
# and App Store builds use the production endpoint.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.altaros.app
APNS_PRIVATE_KEY=
APNS_SANDBOX=false

# --- Storage — Cloudinary -----------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI (ai service) ----------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
